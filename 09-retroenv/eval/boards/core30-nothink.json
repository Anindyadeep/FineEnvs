{
  "name": "core30-nothink",
  "description": "13 models on core30 (10 easy, 10 medium, 10 hard; nested in final_eval), thinking off where the model allows it, no submission repair, the environment's default budget (16 turns, 32 tool calls).",
  "evalset": "data/eval-core30.json",
  "split": "final_eval",
  "common": ["--thinking", "off", "--no-repair", "--max-turns", "16", "--max-tokens", "16000"],
  "max_cost": 25,
  "models": [
    {"provider": "hf", "model": "Qwen/Qwen3.8-27B:novita", "args": ["--tool-choice", "auto"]},
    {"provider": "hf", "model": "Qwen/Qwen3.6-35B-A3B:deepinfra", "args": ["--tool-choice", "auto"]},
    {"provider": "hf", "model": "Qwen/Qwen3.8-2.4T-A95B:together", "args": ["--tool-choice", "auto"]},
    {"provider": "hf", "model": "zai-org/GLM-5.3:novita", "args": ["--tool-choice", "auto"]},
    {"provider": "hf", "model": "deepseek-ai/DeepSeek-V4-Pro-0813:together", "args": ["--tool-choice", "auto"]},
    {"provider": "hf", "model": "deepseek-ai/DeepSeek-V4.1-Flash:novita", "args": ["--tool-choice", "auto"]},
    {"provider": "hf", "model": "moonshotai/Kimi-K2.6:deepinfra", "args": ["--tool-choice", "auto"], "note": "novita rejects the recursive emit_routes schema with a bare 400"},
    {"provider": "hf", "model": "google/gemma-4-31B-it:novita", "args": ["--tool-choice", "auto"]},
    {"provider": "anthropic", "model": "claude-sonnet-5-5"},
    {"provider": "anthropic", "model": "claude-haiku-5-5"},
    {"provider": "anthropic", "model": "claude-opus-5-5", "note": "cannot disable thinking; runs at low effort"},
    {"provider": "openai", "model": "gpt-6.1-sol", "args": ["--reasoning-effort", "low"], "note": "rejects none; low is its floor"},
    {"provider": "openai", "model": "gpt-6-astra", "args": ["--reasoning-effort", "low"], "note": "rejects none; low is its floor", "max_cost": 40}
  ]
}
